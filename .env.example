# Copy file này thành .env (cùng thư mục docker-compose.yml) rồi điền giá trị thật.
# Chỉ cần để dùng các model LLM qua api.shopaikey (gpt-4o-mini/gpt-5-nano/
# gpt-4.1-nano) chọn được trong bảng Cài đặt của app.py. Qwen2.5 7B qua Ollama
# (mặc định) KHÔNG cần biến này.
OPENAI_API_KEY=

# Giới hạn an toàn cho recursive retrieval và generation. Có thể giữ
# nguyên các giá trị mặc định này cho bản demo.
RECURSIVE_MAX_DEPTH=3
RECURSIVE_MAX_ITERATIONS=5
GROUNDING_REPAIR_ATTEMPTS=0
OLLAMA_MAX_TOKENS=1600

# Cross encoder rerank candidate hybrid bằng QUERY GỐC + behavior card được
# trích từ chính query đó. Model/revision được pin để không tự đổi weights.
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_REVISION=1427fd652930e4ba29e8149678df786c240d8825
CROSS_ENCODER_DEVICE=cpu
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_MAX_LENGTH=384
CROSS_ENCODER_CANDIDATE_RATIO=0.20
CROSS_ENCODER_CANDIDATE_MIN_SCORE=0.0
BEHAVIOR_GATE_MIN_SCORE=0.18
BEHAVIOR_GATE_ACTIVATION_SCORE=0.35
RECURSIVE_SEED_SCORE_RATIO=0.70
RECURSIVE_SEED_MIN_SCORE=0.0

# Legal Relevance Filter chạy sau retrieval/recursive expansion, trước generation.
# Cross-encoder của mMARCO thường cho xác suất tuyệt đối nhỏ; kết hợp ngưỡng
# tuyệt đối và tỷ lệ so với Điều tốt nhất để phân loại Cao/Trung bình/Thấp.
LEGAL_RELEVANCE_HIGH_MIN_SCORE=0.005
LEGAL_RELEVANCE_MEDIUM_MIN_SCORE=0.0005
LEGAL_RELEVANCE_HIGH_RATIO=0.65
LEGAL_RELEVANCE_MEDIUM_RATIO=0.15
LEGAL_APPLICABILITY_REPAIR_ATTEMPTS=0
LEGAL_APPLICABILITY_MAX_TOKENS=800
PROXY_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=300
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=0
